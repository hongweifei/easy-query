<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <!-- 定义彩色输出格式和颜色配置 -->
    <Properties>
        <!-- 彩色样式：%highlight{内容}{级别=颜色} -->
        <Property name="COLOR_PATTERN">
            %d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %highlight{%-5level}{FATAL=red blink, ERROR=red, WARN=yellow, INFO=green, DEBUG=blue, TRACE=cyan} %logger{36} - %msg%n
        </Property>
        <Property name="FILE_PATTERN">
            %d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n
        </Property>
        <Property name="LOG_HOME">logs</Property>
    </Properties>

    <Appenders>
        <!-- 控制台彩色输出 -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${COLOR_PATTERN}" disableAnsi="false" noConsoleNoAnsi="false"/>
        </Console>

        <!-- 普通日志文件输出（无颜色） -->
        <RollingFile
            name="RollingFile"
            fileName="${LOG_HOME}/easy-query.log"
            filePattern="${LOG_HOME}/easy-query-%d{yyyy-MM-dd}-%i.log"
        >
            <PatternLayout pattern="${FILE_PATTERN}"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="10MB"/>
                <TimeBasedTriggeringPolicy/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>

        <!-- 错误日志文件输出 -->
        <RollingFile
            name="ErrorFile"
            fileName="${LOG_HOME}/easy-query-error.log"
            filePattern="${LOG_HOME}/easy-query-error-%d{yyyy-MM-dd}-%i.log"
        >
            <PatternLayout pattern="${FILE_PATTERN}"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="5MB"/>
                <TimeBasedTriggeringPolicy/>
            </Policies>
            <DefaultRolloverStrategy max="15"/>
            <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
        </RollingFile>
    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
            <AppenderRef ref="ErrorFile"/>
        </Root>

        <Logger name="com.example" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Logger>

        <Logger name="org.springframework" level="warn" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
    </Loggers>
</Configuration>
